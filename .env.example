# Copy to .env and adjust. No API keys are needed: everything runs locally.
OLLAMA_BASE_URL=http://localhost:11434
RAG_LLM_MODEL=phi4-mini
RAG_JUDGE_MODEL=phi4-mini
RAG_API_URL=http://127.0.0.1:8000

# Protects POST /admin/ingest (header X-Admin-Token). Required in production; empty = open (local dev only).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Docker only
APP_VERSION=0.1.0
OLLAMA_VERSION=0.40.6

# Hugging Face: never contact huggingface.co at runtime; use the pinned revision from the local cache
# (config/models.yaml -> reranker.revision). Set to 0 only to download the model on a fresh machine.
HF_HUB_OFFLINE=1

# Telemetry off (on-prem privacy)
ANONYMIZED_TELEMETRY=False
RAGAS_DO_NOT_TRACK=true
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
LANGCHAIN_TRACING_V2=false
